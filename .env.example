# ========== 方案 A：本地 Ollama（零成本，需 GPU）==========
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
# 小模型可单独指定，用于路由/打分/改写，省时省钱（留空表示复用 LLM_MODEL）
LLM_FAST_MODEL=

EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3

# ========== 方案 B：全 API（不占显存）==========
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat
# LLM_FAST_BASE_URL=https://api.deepseek.com/v1
# LLM_FAST_MODEL=deepseek-chat

# embedding 与 rerank 用硅基流动的 bge-m3 / bge-reranker-v2-m3
# （与本地索引同模型、同 1024 维，切换后无需重建索引）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANK_MODE=http
# RERANK_API=siliconflow          # tei（自建）| siliconflow（Jina 风格）
# RERANK_URL=https://api.siliconflow.cn/v1/rerank
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=sk-xxxx

# ========== 检索 ==========
TOP_K=6
CANDIDATE_K=40
BM25_WEIGHT=0.5
RERANK_MODE=none             # none | lexical | llm | http
# http 模式需要 cross-encoder 服务（TEI 兼容）：POST {query, texts} -> [{index, score}]
# 启动示例：.venv/bin/python scripts/rerank_server.py --port 8080
RERANK_URL=http://127.0.0.1:8080/rerank
RERANK_API=tei
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=
# cross-encoder 用「原始问题」而不是英文改写式（实测 MRR 0.835→0.895）
RERANK_USE_QUESTION=true
# 融合分与重排分的混合权重：0=纯重排，1=纯融合，0.5 实测最优
RERANK_BLEND=0.5
# 重排时把候选池收窄，控制 CPU 延迟
CANDIDATE_K=20
RETRIEVAL_MODE=hybrid        # hybrid（向量+BM25）| sparse（仅 BM25，无需 embedding）
# 多轮记忆：sqlite（重启不丢）| memory（仅测试；进程重启即失忆）
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB=data/checkpoints.sqlite
ATTACK_MAPPING_MODE=keyword  # keyword（默认）| semantic（实验，实测无提升）
CHUNK_TOKENS=420
CHUNK_OVERLAP_TOKENS=60

# ========== 向量后端：numpy（默认）| qdrant ==========
VECTOR_BACKEND=numpy
QDRANT_URL=http://127.0.0.1:6333

# ========== 服务 ==========
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ========== 全 API 模式（零本地模型）==========
# DeepSeek 没有 embeddings，所以检索用纯 BM25，重排用 LLM listwise
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_FAST_BASE_URL=https://api.deepseek.com/v1
# LLM_FAST_MODEL=deepseek-chat
# RETRIEVAL_MODE=sparse
# RERANK_MODE=llm
