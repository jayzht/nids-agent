# ========== 本地 Ollama（默认，零成本）==========
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
# 小模型可单独指定，用于路由/打分/改写，省时省钱（留空表示复用 LLM_MODEL）
LLM_FAST_MODEL=

EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3

# ========== 换成云端 OpenAI 兼容服务（DeepSeek 示例）==========
 LLM_BASE_URL=https://api.deepseek.com/v1
 LLM_API_KEY=sk-xxxx
 LLM_MODEL=deepseek-chat
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_MODEL=BAAI/bge-m3

# ========== 检索 ==========
TOP_K=6
CANDIDATE_K=40
BM25_WEIGHT=0.5
RERANK_MODE=none             # none | lexical | llm | http
# http 模式需要 cross-encoder 服务（TEI 兼容）：POST {query, texts} -> [{index, score}]
# 启动示例：docker run -d --gpus all -p 8080:80 \
#   -v ./data/models/bge-reranker-v2-m3:/models/reranker:ro \
#   ghcr.io/huggingface/text-embeddings-inference:1.8 \
#   --model-id /models/reranker --port 80
RERANK_URL=http://127.0.0.1:8080/rerank
RETRIEVAL_MODE=hybrid        # hybrid（向量+BM25）| sparse（仅 BM25，无需 embedding）
ATTACK_MAPPING_MODE=keyword  # keyword（默认）| semantic（实验，实测无提升）
CHUNK_TOKENS=420
CHUNK_OVERLAP_TOKENS=60

# ========== 向量后端：numpy（默认）| qdrant ==========
VECTOR_BACKEND=numpy
QDRANT_URL=http://127.0.0.1:6333

# ========== 服务 ==========
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
