# ========== 方案 A：本地 Ollama（零成本，需 GPU）==========
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
# 小模型可单独指定，用于路由/打分/改写，省时省钱（留空表示复用 LLM_MODEL）
LLM_FAST_MODEL=

EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024           # 必须和索引一致，不一致会报错（check_providers.py 会先比一次）

# ========== 方案 B：全 API（不占显存）==========
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat
# LLM_FAST_BASE_URL=https://api.deepseek.com/v1
# LLM_FAST_MODEL=deepseek-chat

# embedding 也可以一起上云：硅基流动的 bge-m3 和建索引时是同一个模型
# （1024 维、多语言），换过去无需重建索引；不想让本机跑 embedding 就打开这三行。
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_MODEL=BAAI/bge-m3

# ========== 检索 ==========
TOP_K=6
BM25_WEIGHT=0.5
RETRIEVAL_MODE=hybrid        # hybrid（向量+BM25）| sparse（仅 BM25，无需 embedding）
# 多轮记忆：sqlite（重启不丢）| memory（仅测试；进程重启即失忆）
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB=data/checkpoints.sqlite
# 会话检查点保留天数，启动时清理更早的（0 = 不清理）
CHECKPOINT_RETENTION_DAYS=7

# ---------- 重排：三种后端，同一套 blend 逻辑 ----------
#   http  ：云端 cross-encoder（默认，200ms/次）。RERANK_API 区分协议：
#           siliconflow（Jina 风格，documents → relevance_score）
#           tei（自建，texts → score，scripts/rerank_server.py 可直接跑）
#   local ：本地 transformers 推理，不联网但 3~5s/次（需 data/models/bge-reranker-v2-m3）
#   none  ：不重排，最省；MRR 0.835 → 0.895 的差距就在这里
RERANK_MODE=http
RERANK_API=siliconflow
RERANK_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=sk-xxxx
RERANK_MODEL_PATH=data/models/bge-reranker-v2-m3
# 用「原始问题」而不是英文改写式重排（实测 MRR 0.835→0.895）
RERANK_USE_QUESTION=true
# 融合分与重排分的混合权重：0=纯重排（0.841），1=纯融合（0.835），0.5 实测最优（0.895）
RERANK_BLEND=0.5
# 云端重排超时就降级成规则重排，别让一条外部依赖把整条链路拖到 30s
RERANK_TIMEOUT=5
# 重排只对候选池做，不碰全库
CANDIDATE_K=20
# 同文档限流：一篇论文几十个片段且标题相同，不限制会霸榜
MAX_PER_DOC=5
# 丢掉 tokens 过小的碎片片段（作者列表、目录残行）
MIN_CHUNK_TOKENS=32
# 生成时给前 N 个命中补同文档相邻片段（跨节问题需要）
CONTEXT_NEIGHBORS=1
CONTEXT_NEIGHBOR_TOP=1
ATTACK_MAPPING_MODE=keyword  # keyword（默认）| semantic（实验，实测无提升）
CHUNK_TOKENS=420
CHUNK_OVERLAP_TOKENS=60

# ========== 向量后端：numpy（默认）| qdrant ==========
VECTOR_BACKEND=numpy
QDRANT_URL=http://127.0.0.1:6333

# ========== 服务 ==========
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ========== 全 API 模式（零本地模型）==========
# DeepSeek 没有 embeddings，所以检索用纯 BM25，重排用 LLM listwise
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_FAST_BASE_URL=https://api.deepseek.com/v1
# LLM_FAST_MODEL=deepseek-chat
# RETRIEVAL_MODE=sparse
# RERANK_MODE=llm
